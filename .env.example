# Optional. Without this, remediation and connector.py run in simulation
# mode (no live calls to the real UniFi Cloud API).
# Generate at https://unifi.ui.com -> Settings -> API Keys
UI_CLOUD_API_KEY=

# Used by connector.py to know where to push synced inventory.
# Local backend: leave as-is. Against a deployed backend: your Render URL + /api.
AOC_API_URL=http://localhost:8000/api

# How often connector.py polls the UniFi Cloud API, in seconds.
CONNECTOR_INTERVAL=15
